{
  "name": "@unerr-ai/unerr",
  "version": "0.1.0",
  "description": "Local-first code intelligence CLI for unerr",
  "type": "module",
  "bin": {
    "unerr": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:cli",
    "build:cli": "tsup src/entrypoints/cli.ts --format esm --target node20 --dts --no-splitting",
    "dev": "tsx watch src/entrypoints/cli.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "dev:ui": "vite",
    "build:ui": "vite build && node scripts/check-ui-bundle.mjs",
    "preview:ui": "vite preview",
    "typecheck:ui": "tsc --project src/ui/tsconfig.json",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "test:local-mode": "vitest run src/__tests__/local-mode-offline.test.ts src/__tests__/network-boundary.test.ts",
    "postinstall": "node scripts/postinstall.mjs || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.73",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/openai": "^3.0.57",
    "@anthropic-ai/sdk": "^0.82.0",
    "@clack/prompts": "^1.2.0",
    "@hono/node-server": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@parcel/watcher": "^2.5.6",
    "@sourcegraph/scip-python": "^0.6.6",
    "@sourcegraph/scip-typescript": "^0.4.0",
    "@tanstack/react-query": "^5.90.12",
    "ai": "^6.0.172",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "cli-progress": "^3.12.0",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "consola": "^3.4.2",
    "cozo-node": "^0.7.6",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "hono": "^4.12.16",
    "ignore": "^6.0.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "lucide-react": "^0.511.0",
    "msgpackr": "^1.11.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react": "^19.2.5",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.5",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tinyexec": "^1.1.2",
    "tinypool": "^2.1.0",
    "tree-sitter-wasms": "^0.1.13",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2",
    "web-tree-sitter": "^0.24.3",
    "xstate": "^5.31.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.0",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.10",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs"
  ],
  "license": "Elastic-2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@parcel/watcher",
      "cozo-node",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "cli",
    "code-intelligence",
    "code-graph",
    "knowledge-graph",
    "codebase-indexer",
    "code-search",
    "developer-tools",
    "llm",
    "cursor",
    "claude-code",
    "coding-agent",
    "ai-agent",
    "local-first",
    "ast",
    "static-analysis",
    "typescript"
  ]
}
