{
  "name": "@unerr-ai/unerr",
  "version": "0.5.1",
  "mcpName": "io.github.unerr-ai/unerr",
  "description": "Your AI agent has read your codebase but still can't safely change it. unerr is a local guardrail that hands the agent the call graph and your rules at the moment it edits.",
  "repository": {
    "type": "git",
    "url": "https://github.com/unerr-ai/unerr.git"
  },
  "type": "module",
  "bin": {
    "unerr": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run build:contracts && pnpm run build:cli",
    "build:contracts": "node scripts/build-contracts.mjs",
    "build:cli": "tsup --format esm --target node24 --dts --external cozo-node",
    "build:binary": "bun scripts/build-binary.ts",
    "build:plugins": "tsx scripts/build-plugins.ts",
    "build:plugins:publish": "tsx scripts/build-plugins.ts --publish",
    "dev": "tsx watch src/entrypoints/cli.ts",
    "test": "vitest",
    "test:run": "vitest run < /dev/null",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "test:local-mode": "vitest run src/__tests__/local-mode-offline.test.ts src/__tests__/network-boundary.test.ts",
    "check:tool-budget": "tsx scripts/check-tool-budget.ts",
    "check:native": "node scripts/check-native-modules.mjs",
    "dev:config": "node scripts/dev-config.mjs",
    "dev:entitlement": "node scripts/dev-entitlement.mjs",
    "dev:mcp-probe": "node scripts/dev-mcp-probe.mjs",
    "dev:tier-multirepo": "bash scripts/dev-tier-multirepo-live.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@parcel/watcher": "^2.5.6",
    "@sourcegraph/scip-python": "^0.6.6",
    "@sourcegraph/scip-typescript": "^0.4.0",
    "commander": "^12.1.0",
    "consola": "^3.4.2",
    "cozo-node": "^0.7.6",
    "defuddle": "^0.19.2",
    "gpt-tokenizer": "^3.4.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "ignore": "^6.0.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "jsdom": "^25.0.1",
    "msgpackr": "^1.11.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.5",
    "simple-git": "^3.36.0",
    "tinyexec": "^1.1.2",
    "tinypool": "^2.1.0",
    "tree-sitter-wasms": "^0.1.13",
    "turndown": "^7.2.0",
    "web-tree-sitter": "^0.26.11",
    "wink-bm25-text-search": "^3.1.0",
    "xstate": "^5.31.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/turndown": "^5.0.5",
    "@unerr-ai/contracts": "link:vendor/contracts",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "NOTICE",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "dist/**/*.wasm",
    "!dist/__tests__/**"
  ],
  "license": "Apache-2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@parcel/watcher",
      "cozo-node",
      "esbuild",
      "msgpackr-extract"
    ],
    "overrides": {
      "body-parser@<2.3.0": "^2.3.0",
      "brace-expansion@<1.1.18": "^1.1.18",
      "esbuild@<0.28.1": "^0.28.1",
      "fast-uri@<3.1.5": "^3.1.5",
      "form-data@<4.0.6": "^4.0.6",
      "hono@<4.12.34": "^4.12.34",
      "ip-address@<10.3.1": "^10.3.1",
      "postcss@<8.5.23": "^8.5.23",
      "qs@<6.15.2": "^6.15.2",
      "tar@<7.5.21": "^7.5.21",
      "vite@<7.3.5": "^7.3.5",
      "ws@<8.20.1": "^8.20.1"
    }
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "cli",
    "code-intelligence",
    "code-graph",
    "knowledge-graph",
    "codebase-indexer",
    "code-search",
    "developer-tools",
    "llm",
    "cursor",
    "claude-code",
    "coding-agent",
    "ai-agent",
    "local-first",
    "ast",
    "static-analysis",
    "typescript"
  ]
}
