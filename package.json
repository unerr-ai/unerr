{
  "name": "@unerr-ai/unerr",
  "version": "0.3.2",
  "mcpName": "io.github.unerr-ai/unerr",
  "description": "Your AI agent has read your codebase but still can't safely change it. unerr is a local guardrail that hands the agent the call graph and your rules at the moment it edits.",
  "repository": {
    "type": "git",
    "url": "https://github.com/unerr-ai/unerr-cli.git"
  },
  "type": "module",
  "bin": {
    "unerr": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:cli",
    "build:cli": "tsup src/entrypoints/cli.ts --format esm --target node20 --dts --no-splitting --external cozo-node --external better-sqlite3",
    "dev": "tsx watch src/entrypoints/cli.ts",
    "test": "vitest",
    "test:run": "vitest run < /dev/null",
    "dev:ui": "vite",
    "build:ui": "vite build && node scripts/check-ui-bundle.mjs",
    "typecheck:ui": "tsc --project src/ui/tsconfig.json",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "test:local-mode": "vitest run src/__tests__/local-mode-offline.test.ts src/__tests__/network-boundary.test.ts",
    "check:tool-budget": "tsx scripts/check-tool-budget.ts",
    "check:native": "node scripts/check-native-modules.mjs",
    "dev:config": "node scripts/dev-config.mjs",
    "dev:entitlement": "node scripts/dev-entitlement.mjs",
    "dev:mcp-probe": "node scripts/dev-mcp-probe.mjs",
    "dev:tier-multirepo": "bash scripts/dev-tier-multirepo-live.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@hono/node-server": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@parcel/watcher": "^2.5.6",
    "@sourcegraph/scip-python": "^0.6.6",
    "@sourcegraph/scip-typescript": "^0.4.0",
    "@tanstack/react-query": "^5.90.12",
    "better-sqlite3": "^12.10.0",
    "commander": "^12.1.0",
    "consola": "^3.4.2",
    "cozo-node": "^0.7.6",
    "gpt-tokenizer": "^3.4.0",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "hono": "^4.12.21",
    "ignore": "^6.0.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "msgpackr": "^1.11.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.5",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.5",
    "simple-git": "^3.36.0",
    "tailwindcss": "^4.2.4",
    "tinyexec": "^1.1.2",
    "tinypool": "^2.1.0",
    "tree-sitter-wasms": "^0.1.13",
    "vis-network": "^10.0.2",
    "web-tree-sitter": "^0.24.3",
    "xstate": "^5.31.0",
    "zod": "^4.4.1",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "^0.18.1",
    "jsdom": "^25.0.1",
    "turndown": "^7.2.0",
    "wink-bm25-text-search": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^6.0.1",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "NOTICE",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "dist/**/*.wasm",
    "!dist/__tests__/**",
    "dist/ui/index.html",
    "dist/ui/*.svg",
    "dist/ui/*.png",
    "dist/ui/fonts/**",
    "!dist/ui/assets/**",
    "!dist/ui/screenshots/**",
    "!dist/ui/prototype-sandbox/**"
  ],
  "license": "Apache-2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@parcel/watcher",
      "better-sqlite3",
      "cozo-node",
      "esbuild",
      "msgpackr-extract"
    ],
    "overrides": {
      "fast-uri@<3.1.2": ">=3.1.2",
      "ip-address@<10.1.1": ">=10.1.1",
      "postcss@<8.5.10": ">=8.5.10",
      "qs@<6.15.2": ">=6.15.2",
      "tar@<7.5.11": "^7.5.11",
      "ws@<8.20.1": "^8.20.1"
    }
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "cli",
    "code-intelligence",
    "code-graph",
    "knowledge-graph",
    "codebase-indexer",
    "code-search",
    "developer-tools",
    "llm",
    "cursor",
    "claude-code",
    "coding-agent",
    "ai-agent",
    "local-first",
    "ast",
    "static-analysis",
    "typescript"
  ]
}
